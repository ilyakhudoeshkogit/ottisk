<Window x:Class="Ottisk.App.CalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Как вышло?" Width="640" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="White" FontFamily="Segoe UI" Icon="Assets/ottisk.ico">
    <StackPanel Margin="28,22,28,24">
        <TextBlock Text="Как вышло?" FontSize="28" FontWeight="Bold"/>
        <TextBlock Text="Возьмите пробный лист и посмотрите на обе стороны." FontSize="17" Foreground="#607D8B" Margin="0,4,0,16" TextWrapping="Wrap"/>
        <Button Style="{StaticResource BigButton}" HorizontalContentAlignment="Left" Margin="0,0,0,10" Click="Correct_Click">
            <StackPanel>
                <TextBlock Text="✅  Всё ровно" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="«1» с одной стороны, «2» с другой, обе стрелки смотрят в одну сторону" FontSize="14" Foreground="#607D8B" TextWrapping="Wrap"/>
            </StackPanel>
        </Button>
        <Button Style="{StaticResource BigButton}" HorizontalContentAlignment="Left" Margin="0,0,0,10" Click="UpsideDown_Click">
            <StackPanel>
                <TextBlock Text="🔃  «2» вверх ногами" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="Стрелки смотрят в разные стороны" FontSize="14" Foreground="#607D8B" TextWrapping="Wrap"/>
            </StackPanel>
        </Button>
        <Button Style="{StaticResource BigButton}" HorizontalContentAlignment="Left" Margin="0,0,0,10" Click="SameSide_Click">
            <StackPanel>
                <TextBlock Text="📄  «2» оказалась на той же стороне, что и «1»" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Text="Вторая сторона листа осталась чистой" FontSize="14" Foreground="#607D8B" TextWrapping="Wrap"/>
            </StackPanel>
        </Button>
        <Button Content="Не знаю / потом" Style="{StaticResource BigButton}" FontSize="14" HorizontalAlignment="Right" Padding="22,8" Margin="0,6,0,0" Click="Cancel_Click"/>
    </StackPanel>
</Window>
