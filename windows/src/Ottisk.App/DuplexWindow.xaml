<Window x:Class="Ottisk.App.DuplexWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Переверните бумагу" Width="760" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="White" FontFamily="Segoe UI" Icon="Assets/ottisk.ico">
    <StackPanel Margin="28,22,28,24">
        <TextBlock x:Name="HeaderText" Text="Первая сторона напечатана" FontSize="28" FontWeight="Bold"/>
        <TextBlock x:Name="WaitText" FontSize="17" Foreground="#E65100" Margin="0,6,0,14" TextWrapping="Wrap" Text="Принтер ещё печатает — дождитесь, пока выйдет последний лист."/>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10"><Border Width="40" Height="40" CornerRadius="20" Background="#2E7D32"><TextBlock Text="1" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <TextBlock Text="Дождитесь последнего листа и возьмите всю стопку из приёмного лотка." FontSize="18" TextWrapping="Wrap" Width="400" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10"><Border Width="40" Height="40" CornerRadius="20" Background="#2E7D32"><TextBlock Text="2" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <TextBlock x:Name="Step2Text" Text="Не переворачивая, поверните стопку на столе на пол-оборота (как разворачивают газету), чтобы нижний край стал верхним." FontSize="18" TextWrapping="Wrap" Width="400" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel>
                <StackPanel Orientation="Horizontal"><Border Width="40" Height="40" CornerRadius="20" Background="#2E7D32"><TextBlock Text="3" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <TextBlock Text="Положите в лоток подачи чистой стороной к печати (так же, как кладёте обычную бумагу). Нажмите кнопку ниже." FontSize="18" TextWrapping="Wrap" Width="400" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel>
            </StackPanel>
            <!-- Картинка: напечатанная сторона, стрелка поворота, лоток -->
            <Canvas Grid.Column="1" Width="220" Height="230" Margin="10,0,0,0">
                <Border Canvas.Left="20" Canvas.Top="10" Width="80" Height="108" Background="White" BorderBrush="#455A64" BorderThickness="2" CornerRadius="2">
                    <StackPanel Margin="10,12"><TextBlock Text="Аб" FontSize="22" FontWeight="Bold" Foreground="#455A64"/><Rectangle Height="4" Fill="#B0BEC5" Margin="0,6,0,0"/><Rectangle Height="4" Fill="#B0BEC5" Margin="0,6,0,0"/><Rectangle Height="4" Fill="#B0BEC5" Margin="0,6,0,0"/></StackPanel>
                </Border>
                <TextBlock x:Name="TurnIcon" Canvas.Left="108" Canvas.Top="38" Text="⟳" FontSize="64" Foreground="#2E7D32"/>
                <TextBlock x:Name="TurnLabel" Canvas.Left="108" Canvas.Top="104" Text="180°" FontSize="18" FontWeight="Bold" Foreground="#2E7D32"/>
                <Border Canvas.Left="20" Canvas.Top="140" Width="180" Height="70" Background="#ECEFF1" BorderBrush="#455A64" BorderThickness="2" CornerRadius="6">
                    <TextBlock Text="лоток подачи&#10;чистой стороной к печати" FontSize="13" TextAlignment="Center" VerticalAlignment="Center" Foreground="#455A64"/>
                </Border>
            </Canvas>
        </Grid>

        <TextBlock x:Name="CountText" FontSize="14" Foreground="#607D8B" Margin="0,14,0,0" TextWrapping="Wrap"/>
        <Button x:Name="GoButton" Style="{StaticResource PrimaryButton}" Content="Перевернул — печатать дальше" Height="68" Margin="0,16,0,0" IsEnabled="False" Click="Go_Click"/>
        <Grid Margin="0,12,0,0">
            <Button x:Name="SkipButton" Content="Принтер уже допечатал — продолжить" Style="{StaticResource BigButton}" FontSize="14" HorizontalAlignment="Left" Visibility="Collapsed" Click="Skip_Click"/>
            <Button Content="Отмена" Style="{StaticResource BigButton}" FontSize="14" HorizontalAlignment="Right" Padding="22,8" Click="Cancel_Click"/>
        </Grid>
    </StackPanel>
</Window>
