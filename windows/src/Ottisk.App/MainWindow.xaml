<Window x:Class="Ottisk.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Оттиск — печать" Width="1180" Height="780" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen" AllowDrop="True" Background="White"
        Icon="Assets/ottisk.ico" FontFamily="Segoe UI" Drop="Window_Drop" DragOver="Window_DragOver">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель -->
        <DockPanel Grid.Column="0" Background="White">
            <Border DockPanel.Dock="Bottom" Padding="20,12,20,18" Background="White" BorderBrush="#CFD8DC" BorderThickness="0,1,0,0">
                <StackPanel>
                    <TextBlock x:Name="SummaryText" FontSize="15" TextWrapping="Wrap" Margin="0,0,0,8" Text=" "/>
                    <Button x:Name="PrintButton" Style="{StaticResource PrimaryButton}" Content="🖨  ПЕЧАТАТЬ" Click="Print_Click" IsEnabled="False" Height="68"/>
                </StackPanel>
            </Border>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20,6,20,10">
                    <TextBlock Text="1. Файл" Style="{StaticResource Step}"/>
                    <Button Style="{StaticResource BigButton}" Click="Open_Click" Content="📂  Открыть файл…" HorizontalContentAlignment="Left"/>
                    <TextBlock x:Name="FileText" FontSize="15" Margin="0,6,0,0" TextWrapping="Wrap" Text="Или перетащите файл PDF / фото в окно"/>

                    <TextBlock Text="2. Принтер" Style="{StaticResource Step}"/>
                    <ComboBox x:Name="PrinterBox" FontSize="18" Padding="8,6" SelectionChanged="Printer_Changed"/>
                    <TextBlock x:Name="PrinterStatus" FontSize="14" Margin="0,4,0,0" Foreground="#607D8B" TextWrapping="Wrap"/>

                    <TextBlock Text="3. Как печатать" Style="{StaticResource Step}"/>
                    <StackPanel x:Name="PresetPanel"/>

                    <TextBlock Text="4. Сколько и какие страницы" Style="{StaticResource Step}"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Копий:" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button Content="−" Width="48" Height="48" FontSize="26" Style="{StaticResource BigButton}" Padding="0" Click="CopiesMinus_Click" ToolTip="Меньше"/>
                        <TextBlock x:Name="CopiesText" Text="1" FontSize="26" FontWeight="Bold" Width="60" TextAlignment="Center" VerticalAlignment="Center"/>
                        <Button Content="+" Width="48" Height="48" FontSize="26" Style="{StaticResource BigButton}" Padding="0" Click="CopiesPlus_Click" ToolTip="Больше"/>
                    </StackPanel>
                    <RadioButton x:Name="AllPages" Content="Все страницы" FontSize="18" IsChecked="True" Margin="0,14,0,0" Checked="Pages_Changed"/>
                    <RadioButton x:Name="SomePages" FontSize="18" Margin="0,8,0,0" Checked="Pages_Changed">
                        <TextBlock Text="Только эти страницы:" FontSize="18"/>
                    </RadioButton>
                    <TextBox x:Name="RangeBox" FontSize="20" Padding="6" Margin="26,6,0,0" IsEnabled="False" TextChanged="Range_Changed" ToolTip="Например: 1-3, 5, 8-"/>
                    <TextBlock Text="Например:  1-3, 5, 8-" FontSize="13" Margin="26,2,0,0" Foreground="#607D8B"/>
                    <TextBlock x:Name="RangeError" FontSize="14" Margin="26,4,0,0" Foreground="#C62828" TextWrapping="Wrap"/>

                    <TextBlock Text="5. Дополнительно" Style="{StaticResource Step}"/>
                    <CheckBox x:Name="MonoBox" Content="Чёрно-белая печать (экономит краску)" Click="Options_Changed"/>
                    <TextBlock x:Name="MonoNote" FontSize="13" Foreground="#607D8B" Margin="24,0,0,0" TextWrapping="Wrap"/>
                    <CheckBox x:Name="GutterBox" Content="Поле слева для дырокола (+20 мм)" Click="Options_Changed"/>
                    <TextBlock x:Name="GutterNote" Text="В пресете «Курсовая / ГОСТ» поле слева уже 30 мм" FontSize="13" Foreground="#607D8B" Margin="24,0,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBlock Text="Бумага:" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <ComboBox x:Name="PaperBox" FontSize="17" Padding="8,5" MinWidth="250" SelectionChanged="Paper_Changed" ToolTip="Какая бумага лежит в принтере"/>
                    </StackPanel>
                    <CheckBox x:Name="NumbersBox" Content="Номера страниц (внизу по центру)" Margin="0,14,0,0" Click="Numbering_Changed"/>
                    <StackPanel x:Name="NumbersPanel" Margin="24,2,0,0" IsEnabled="False">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Начать с:" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Button Content="−" Width="40" Height="40" FontSize="22" Style="{StaticResource BigButton}" Padding="0" Click="NumberMinus_Click" ToolTip="Меньше"/>
                            <TextBlock x:Name="NumberStartText" Text="1" FontSize="20" FontWeight="Bold" Width="56" TextAlignment="Center" VerticalAlignment="Center"/>
                            <Button Content="+" Width="40" Height="40" FontSize="22" Style="{StaticResource BigButton}" Padding="0" Click="NumberPlus_Click" ToolTip="Больше"/>
                        </StackPanel>
                        <CheckBox x:Name="SkipTitleBox" Content="Без номера на первой странице (титул)" FontSize="15" Margin="0,6,0,0" IsChecked="True" Click="Numbering_Changed"/>
                        <TextBlock Text="Титул считается первой страницей, но номер на нём не печатается (ГОСТ 7.32)" FontSize="13" Foreground="#607D8B" Margin="24,0,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <CheckBox x:Name="TrimBox" Content="Обрезать белые поля исходника" Margin="0,10,0,0" Click="Trim_Changed"/>
                    <TextBlock Text="Для сканов и курсовой по ГОСТ: лишние белые края файла убираются, текст лучше встаёт в поля" FontSize="13" Foreground="#607D8B" Margin="24,0,0,0" TextWrapping="Wrap"/>
                    <CheckBox x:Name="WatermarkBox" Content="Водяной знак по диагонали" Margin="0,10,0,0" Click="Watermark_Changed"/>
                    <ComboBox x:Name="WatermarkCombo" IsEditable="True" FontSize="17" Padding="8,5" Margin="24,4,0,0" IsEnabled="False" ToolTip="Можно выбрать из списка или написать своё слово"/>
                    <Expander x:Name="DuplexExpander" Header="Двусторонняя печать: пробный лист и настройки" FontSize="14" Margin="0,12,0,0">
                        <StackPanel Margin="8,6,0,0">
                            <Button x:Name="TestSheetButton" Style="{StaticResource BigButton}" HorizontalContentAlignment="Left" Click="TestSheet_Click">
                                <StackPanel>
                                    <TextBlock Text="🧪  Напечатать пробный лист" FontSize="17" FontWeight="SemiBold"/>
                                    <TextBlock Text="1 лист: «1» с одной стороны, «2» с другой. Оттиск сам поставит галочки ниже." FontSize="13" Foreground="#607D8B" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Button>
                            <CheckBox x:Name="FlipBox" Content="Оборот выходит вверх ногами" FontSize="15" Margin="0,10,0,0" Click="Options_Changed"/>
                            <CheckBox x:Name="FaceUpBox" Content="Принтер выкладывает листы лицом вверх" FontSize="15" Click="Options_Changed"/>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <!-- Превью -->
        <Grid Grid.Column="1" Background="{StaticResource Soft}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Так напечатается" FontSize="20" FontWeight="Bold" Margin="24,16,24,0"/>
            <Grid Grid.Row="1" Margin="24,10">
                <Border x:Name="PreviewFrame" Background="White" BorderBrush="#B0BEC5" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.25"/></Border.Effect>
                    <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <StackPanel x:Name="EmptyHint" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="📄" FontSize="72" TextAlignment="Center"/>
                    <TextBlock Text="Перетащите сюда PDF или фото" FontSize="24" TextAlignment="Center" Margin="0,8,0,16"/>
                    <Button Style="{StaticResource BigButton}" Content="Открыть файл…" Click="Open_Click" HorizontalAlignment="Center" Padding="30,12"/>
                    <TextBlock Text="Документ Word? Сохраните его как PDF (Файл → Сохранить как)" FontSize="14" Foreground="#607D8B" TextAlignment="Center" Margin="0,16,0,0"/>
                </StackPanel>
                <TextBlock x:Name="BusyText" Text="Готовлю картинку…" FontSize="18" Foreground="#607D8B" VerticalAlignment="Bottom" HorizontalAlignment="Center" Visibility="Collapsed"/>
            </Grid>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                <Button x:Name="PrevButton" Content="◀  Назад" Style="{StaticResource BigButton}" Click="Prev_Click" Width="130"/>
                <TextBlock x:Name="PageLabel" FontSize="17" Width="330" TextAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <Button x:Name="NextButton" Content="Дальше  ▶" Style="{StaticResource BigButton}" Click="Next_Click" Width="130"/>
            </StackPanel>
        </Grid>

        <!-- Экран ожидания -->
        <Border x:Name="BusyOverlay" Grid.ColumnSpan="2" Background="#CCFFFFFF" Visibility="Collapsed">
            <TextBlock x:Name="BusyOverlayText" Text="Отправляю на принтер…" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
